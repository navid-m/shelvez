/// `shelvez init` project scaffolding.

val allocators = use("std/allocators")
val stdio      = use("std/stdio")
val str        = use("std/string")
val util       = use("sxutil.sx")

val DOC_INDEX: str.StringView = \\# Welcome
\\
\\This site is generated by **Shelvez**, a static documentation tool.
\\It turns a folder of Markdown files into a clean, searchable website.
\\
\\## Start here
\\
\\- [Installation](getting-started/installation.md)
\\- [Writing pages](getting-started/writing.md)
\\- [Configuration](reference/configuration.md)
\\- [Markdown reference](reference/markdown.md)
\\
\\> The sidebar is built from the folder structure automatically.
\\> Add a Markdown file, save it, and the development server reloads the page.

val DOC_GETTING_STARTED: str.StringView = \\# Getting started
\\
\\Shelvez reads `index.json` from the project root, scans the content
\\directory, renders each Markdown file, and writes a static site to
\\`dist/`.
\\
\\## The three commands
\\
\\| Command | Purpose |
\\| --- | --- |
\\| `shelvez init` | Create `index.json` and an example `docs/` tree. |
\\| `shelvez serve` | Start a local server that reloads when files change. |
\\| `shelvez build` | Write the complete site to `dist/`. |
\\
\\Folders become collapsible sections in the sidebar. A file named
\\`index.md` becomes the page for its folder.

val DOC_INSTALLATION: str.StringView = \\# Installation
\\
\\Build Shelvez from source with the Spectre toolchain:
\\
\\```sh
\\spectre build release
\\```
\\
\\The binary is written to `./shelvez`. You can also run the development
\\build directly:
\\
\\```sh
\\spectre build dev
\\./shelvez-dev serve
\\```
\\
\\## Requirements
\\
\\- Spectre v0.0.18 or newer
\\- A C runtime for the generated binary
\\
\\Shelvez has no JavaScript build step and no external dependencies.

val DOC_WRITING: str.StringView = \\# Writing pages
\\
\\Every `.md` or `.markdown` file below the content directory becomes a
\\page. The path determines the URL:
\\
\\| Source | URL |
\\| --- | --- |
\\| `docs/index.md` | `/` |
\\| `docs/guide/setup.md` | `/guide/setup/` |
\\| `docs/guide/index.md` | `/guide/` |
\\
\\## Titles and descriptions
\\
\\The first level-one heading becomes the page title. You can override it
\\with front matter:
\\
\\```markdown
\\---
\\title: Installing Shelvez
\\description: Build the tool from source.
\\---
\\```
\\
\\## Links and images
\\
\\Relative links to Markdown files are rewritten to clean URLs. Other
\\relative paths are resolved from the page's source folder, so images
\\placed next to a page keep working after the build.

val DOC_CONFIGURATION: str.StringView = \\# Configuration
\\
\\The project root contains `index.json`:
\\
\\```json
\\{
\\  "title": "My Documentation",
\\  "description": "A short description.",
\\  "content": "docs",
\\  "structure": "inferred",
\\  "port": 3000
\\}
\\```
\\
\\| Key | Meaning |
\\| --- | --- |
\\| `title` | Site name shown in the header and browser title. |
\\| `description` | Default meta description. |
\\| `content` | Folder containing Markdown and static assets. |
\\| `structure` | `"inferred"` or an explicit array of sections and pages. |
\\| `port` | Default port for `shelvez serve`. |
\\
\\## Explicit structure
\\
\\Set `structure` to an array when the sidebar order must be fixed:
\\
\\```json
\\"structure": [
\\  { "title": "Guide", "children": [
\\    { "title": "Setup", "path": "guide/setup.md" }
\\  ] }
\\]
\\```
\\
\\Pages listed explicitly must exist below the content directory.

val DOC_MARKDOWN: str.StringView = \\# Markdown reference
\\
\\Shelvez renders a practical subset of GitHub-flavored Markdown and
\\generates heading anchors, a page outline, and a client-side search
\\index.
\\
\\## Supported blocks
\\
\\- Headings, paragraphs, and horizontal rules
\\- Ordered, unordered, and task lists
\\- Fenced and indented code blocks
\\- Tables with column alignment
\\- Blockquotes
\\- Images and links
\\- Raw HTML blocks
\\
\\## Inline formatting
\\
\\Use **bold**, *italic*, `inline code`, ~~strikethrough~~, and
\\[links](https://example.com).
\\
\\## Code fences
\\
\\Fenced code is highlighted for common languages:
\\
\\```spectre
\\pub fn main() i32 = {
\\    return 0
\\}
\\```
\\
\\## Task lists
\\
\\- [x] Write a page
\\- [ ] Run `shelvez build`
\\- [ ] Publish `dist/`

fn write_new(
    ar: allocators.ScopedArenaAllocator,
    path: str.StringView,
    data: str.StringView,
    force: bool
) bool = trust {
    if util.file_exists(path) && !force {
        return true
    }
    val payload: mut str.StringView = data
    if data.len == 0 || @load8(@ptradd(data.ptr, data.len - 1)) != 10 {
        payload = util.view_concat3(ar, data, "\n", "")
    }
    return util.write_file(path, payload)
}

pub fn init(root: str.StringView, force: bool) i32 = trust {
    val arena_opt = allocators.ScopedArena.new(65536 as usize)
    val arena: mut allocators.ScopedArenaAllocator = none
    match arena_opt {
        ok a => {
            arena = a
        }
        err _ => {
            stdio.eputs("Could not allocate memory.\n")
            return 1
        }
    }
    if !util.mkdir_p(root) {
        stdio.print("Could not create directory: {s}\n", {root})
        allocators.ScopedArena.free(arena)
        return 1
    }
    val index_path: str.StringView = util.path_join(arena, root, "index.json")
    if util.file_exists(index_path) && !force {
        stdio.print("index.json already exists in {s}. Use --force to overwrite.\n", {root})
        allocators.ScopedArena.free(arena)
        return 1
    }
    val docs_dir: str.StringView = util.path_join(arena, root, "docs")
    val started: str.StringView = util.path_join(arena, docs_dir, "getting-started")
    val reference: str.StringView = util.path_join(arena, docs_dir, "reference")
    util.mkdir_p(docs_dir)
    util.mkdir_p(started)
    util.mkdir_p(reference)
    val title: mut str.StringView = "Documentation"
    val base: str.StringView = util.view_base(root)
    if root.len > 1 && base.len > 0 && !str.eql(base, ".") {
        title = util.prettify_name(arena, util.view_stem(base))
    }
    val json: mut util.ABuf = util.abuf_new(arena)
    util.abuf_append(arena, @addr(json), "{\n  \"title\": \"")
    util.abuf_append(arena, @addr(json), util.json_escape_buf(arena, title))
    util.abuf_append(arena, @addr(json), "\",\n  \"description\": \"Documentation for ")
    util.abuf_append(arena, @addr(json), util.json_escape_buf(arena, title))
    util.abuf_append(
        arena,
        @addr(json),
        "\",\n  \"content\": \"docs\",\n  \"structure\": \"inferred\",\n  \"port\": 3000\n}\n"
    )
    write_new(arena, index_path, util.abuf_view(@addr(json)), force)
    write_new(arena, util.path_join(arena, docs_dir, "index.md"), DOC_INDEX, force)
    write_new(arena, util.path_join(arena, started, "index.md"), DOC_GETTING_STARTED, force)
    write_new(arena, util.path_join(arena, started, "installation.md"), DOC_INSTALLATION, force)
    write_new(arena, util.path_join(arena, started, "writing.md"), DOC_WRITING, force)
    write_new(arena, util.path_join(arena, reference, "configuration.md"), DOC_CONFIGURATION, force)
    write_new(arena, util.path_join(arena, reference, "markdown.md"), DOC_MARKDOWN, force)
    stdio.puts("")
    stdio.print("Created a Shelvez documentation project in {s}\n", {root})
    stdio.puts("  index.json")
    stdio.puts("  docs/")
    stdio.puts("")
    stdio.puts("Next steps:")
    stdio.puts("  shelvez serve")
    stdio.puts("  shelvez build")
    stdio.puts("")
    allocators.ScopedArena.free(arena)
    return 0
}
