fn attr(
    ar: allocators.ScopedArenaAllocator,
    b: mut ref util.ABuf,
    value: str.StringView
) void = trust {
    util.html_escape(ar, b, value)
}

fn render_nav_node(
    ar: allocators.ScopedArenaAllocator,
    b: mut ref util.ABuf,
    node: ref tree.NavNode,
    current: str.StringView
) void = trust {
    val has_children: bool = @len(node.children) > 0
    if has_children {
        val open: bool = tree.node_contains(node, current)
        util.abuf_append(ar, b, "<li><details class=\"nav-section\" data-section=\"")
        attr(ar, b, node.title)
        util.abuf_append(ar, b, "\"")
        if open {
            util.abuf_append(ar, b, " open")
        }
        util.abuf_append(ar, b, "><summary><span class=\"chevron\"></span><span>")
        attr(ar, b, node.title)
        util.abuf_append(ar, b, "</span></summary><ul>")
        if node.url.len > 0 {
            util.abuf_append(ar, b, "<li><a href=\"")
            attr(ar, b, node.url)
            util.abuf_append(ar, b, "\"")
            if str.eql(node.url, current) {
                util.abuf_append(ar, b, " class=\"active\"")
            }
            util.abuf_append(ar, b, ">Overview</a></li>")
        }
        val n: i64 = @len(node.children) as i64
        val i: mut i64 = 0
        for {
            if i >= n {
                break
            }
            if @get(node.children, i as usize) is some child {
                render_nav_node(ar, b, child, current)
            }
            i++
        }
        util.abuf_append(ar, b, "</ul></details></li>")
    } else {
        util.abuf_append(ar, b, "<li><a href=\"")
        attr(ar, b, node.url)
        util.abuf_append(ar, b, "\"")
        if str.eql(node.url, current) {
            util.abuf_append(ar, b, " class=\"active\"")
        }
        util.abuf_append(ar, b, ">")
        attr(ar, b, node.title)
        util.abuf_append(ar, b, "</a></li>")
    }
}

fn render_nav(
    ar: allocators.ScopedArenaAllocator,
    b: mut ref util.ABuf,
    root: ref tree.NavNode,
    current: str.StringView
) void = trust {
    util.abuf_append(ar, b, "<nav class=\"nav-tree\" aria-label=\"Documentation\"><ul>")
    val n: i64 = @len(root.children) as i64
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        if @get(root.children, i as usize) is some child {
            render_nav_node(ar, b, child, current)
        }
        i++
    }
    util.abuf_append(ar, b, "</ul></nav>")
}

fn collect_crumbs(
    la: allocators.ListArena,
    node: ref tree.NavNode
) option[list[ref tree.NavNode]] = trust {
    match @listalloc[allocators.ListArena, ref tree.NavNode](la) {
        ok crumbs => {
            val chain: mut list[ref tree.NavNode] = crumbs
            val cursor: mut ref tree.NavNode = node
            for {
                if cursor == none {
                    break
                }
                @insert(chain, 0 as usize, cursor)
                cursor = cursor.parent
            }
            return some chain
        }
        err _ => {
            return none
        }
    }
}

fn render_breadcrumbs(
    ar: allocators.ScopedArenaAllocator,
    la: allocators.ListArena,
    b: mut ref util.ABuf,
    root: ref tree.NavNode,
    page: ref tree.Page
) void = trust {
    if tree.find_node(root, page.url) is some node {
        if collect_crumbs(la, node) is some crumbs {
            val n: i64 = @len(crumbs) as i64
            if n <= 1 {
                return
            }
            util.abuf_append(ar, b, "<div class=\"breadcrumbs\">")
            val i: mut i64 = 1
            for {
                if i >= n {
                    break
                }
                if i > 1 {
                    util.abuf_append(ar, b, "<span class=\"sep\">/</span>")
                }
                if @get(crumbs, i as usize) is some crumb {
                    if i == n - 1 {
                        util.abuf_append(ar, b, "<span class=\"current\">")
                        attr(ar, b, crumb.title)
                        util.abuf_append(ar, b, "</span>")
                    } elif crumb.url.len > 0 {
                        util.abuf_append(ar, b, "<a href=\"")
                        attr(ar, b, crumb.url)
                        util.abuf_append(ar, b, "\">")
                        attr(ar, b, crumb.title)
                        util.abuf_append(ar, b, "</a>")
                    } else {
                        util.abuf_append(ar, b, "<span>")
                        attr(ar, b, crumb.title)
                        util.abuf_append(ar, b, "</span>")
                    }
                }
                i++
            }
            util.abuf_append(ar, b, "</div>")
        }
    }
}

fn page_index(pages: list[ref tree.Page], url: str.StringView) i64 = trust {
    val n: i64 = @len(pages) as i64
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        if @get(pages, i as usize) is some candidate {
            if str.eql(candidate.url, url) {
                return i
            }
        }
        i++
    }
    return -1
}

fn render_page_nav(
    ar: allocators.ScopedArenaAllocator,
    b: mut ref util.ABuf,
    pages: list[ref tree.Page],
    page: ref tree.Page
) void = trust {
    val idx: i64 = page_index(pages, page.url)
    if idx < 0 {
        return
    }
    val n: i64 = @len(pages) as i64
    if n <= 1 {
        return
    }
    val has_prev: bool = idx > 0
    val has_next: bool = idx + 1 < n
    if !has_prev && !has_next {
        return
    }
    util.abuf_append(ar, b, "<nav class=\"page-nav\" aria-label=\"Previous and next\">")
    if has_prev {
        if @get(pages, (idx - 1) as usize) is some prev {
            util.abuf_append(ar, b, "<a class=\"prev\" href=\"")
            attr(ar, b, prev.url)
            util.abuf_append(ar, b, "\"><span class=\"dir\">Previous</span><span class=\"label\">")
            attr(ar, b, prev.title)
            util.abuf_append(ar, b, "</span></a>")
        }
    }
    if has_next {
        if @get(pages, (idx + 1) as usize) is some next {
            util.abuf_append(ar, b, "<a class=\"next\" href=\"")
            attr(ar, b, next.url)
            util.abuf_append(ar, b, "\"><span class=\"dir\">Next</span><span class=\"label\">")
            attr(ar, b, next.title)
            util.abuf_append(ar, b, "</span></a>")
        }
    }
    util.abuf_append(ar, b, "</nav>")
}

pub fn render_page(
    ar: allocators.ScopedArenaAllocator,
    la: allocators.ListArena,
    cfg: config.Config,
    root: ref tree.NavNode,
    pages: list[ref tree.Page],
    page: ref tree.Page,
    live: bool,
    version: i64
) str.StringView = trust {
    val b: mut util.ABuf = util.abuf_new(ar)
    util.abuf_append(ar, @addr(b), HEAD_OPEN)
    attr(ar, @addr(b), page.title)
    if page.title.len > 0 && cfg.title.len > 0 {
        util.abuf_append(ar, @addr(b), " · ")
        attr(ar, @addr(b), cfg.title)
    }
    util.abuf_append(ar, @addr(b), HEAD_TITLE_END)
    val desc: mut str.StringView = cfg.description
    if page.description.len > 0 {
        desc = page.description
    }
    attr(ar, @addr(b), desc)
    util.abuf_append(ar, @addr(b), HEAD_DESC_END)
    if live {
        util.abuf_append(ar, @addr(b), "<script>window.SHELVEZ_LIVE=true;window.SHELVEZ_VERSION=\"")
        util.abuf_append_int(ar, @addr(b), version)
        util.abuf_append(ar, @addr(b), "\";</script>\n")
    }
    util.abuf_append(ar, @addr(b), "</head>\n")
    util.abuf_append(ar, @addr(b), TOPBAR_OPEN)
    util.abuf_append(ar, @addr(b), ICON_MENU)
    util.abuf_append(ar, @addr(b), TOPBAR_BRAND_OPEN)
    attr(ar, @addr(b), cfg.title)
    util.abuf_append(ar, @addr(b), SEARCH_OPEN)
    util.abuf_append(ar, @addr(b), ICON_SEARCH)
    util.abuf_append(ar, @addr(b), SEARCH_CLOSE)
    util.abuf_append(ar, @addr(b), ICON_HOME)
    util.abuf_append(ar, @addr(b), ACTIONS_MID)
    util.abuf_append(ar, @addr(b), ICON_SUN)
    util.abuf_append(ar, @addr(b), ICON_MOON)
    util.abuf_append(ar, @addr(b), ACTIONS_END)
    if page.toc.len > 0 {
        util.abuf_append(ar, @addr(b), SIDEBAR_TOC_OPEN)
        util.abuf_append(ar, @addr(b), page.toc)
        util.abuf_append(ar, @addr(b), SIDEBAR_TOC_CLOSE)
    }
    util.abuf_append(ar, @addr(b), SIDEBAR_MENU_OPEN)
    util.abuf_append(ar, @addr(b), ICON_HOME)
    util.abuf_append(ar, @addr(b), SIDEBAR_MENU_MID)
    render_nav(ar, @addr(b), root, page.url)
    util.abuf_append(ar, @addr(b), SIDEBAR_MENU_END)
    render_breadcrumbs(ar, la, @addr(b), root, page)
    util.abuf_append(ar, @addr(b), PAGE_HEADER_OPEN)
    attr(ar, @addr(b), page.title)
    if page.description.len > 0 {
        util.abuf_append(ar, @addr(b), PAGE_DESC_OPEN)
        attr(ar, @addr(b), page.description)
        util.abuf_append(ar, @addr(b), PAGE_DESC_CLOSE)
    } else {
        util.abuf_append(ar, @addr(b), "</h1>\n      </header>")
    }
    util.abuf_append(ar, @addr(b), "<article class=\"markdown\">")
    util.abuf_append(ar, @addr(b), page.body_html)
    util.abuf_append(ar, @addr(b), "</article>\n")
    render_page_nav(ar, @addr(b), pages, page)
    util.abuf_append(ar, @addr(b), CONTENT_END)
    return util.abuf_view(@addr(b))
}

pub fn build_search_json(
    ar: allocators.ScopedArenaAllocator,
    pages: list[ref tree.Page]
) str.StringView = trust {
    val b: mut util.ABuf = util.abuf_new(ar)
    util.abuf_append(ar, @addr(b), "[")
    val n: i64 = @len(pages) as i64
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        if @get(pages, i as usize) is some page {
            if i > 0 {
                util.abuf_append(ar, @addr(b), ",")
            }
            util.abuf_append(ar, @addr(b), "\n{\"title\":\"")
            util.abuf_append(ar, @addr(b), util.json_escape_buf(ar, page.title))
            util.abuf_append(ar, @addr(b), "\",\"context\":\"")
            val context: mut str.StringView = page.description
            if context.len == 0 && page.nav.parent != none {
                context = page.nav.parent.title
            }
            util.abuf_append(ar, @addr(b), util.json_escape_buf(ar, context))
            util.abuf_append(ar, @addr(b), "\",\"url\":\"")
            util.abuf_append(ar, @addr(b), util.json_escape_buf(ar, page.url))
            util.abuf_append(ar, @addr(b), "\",\"text\":\"")
            val text: str.StringView = markdown.plain_text(ar, page.body)
            val clipped: mut str.StringView = text
            if text.len > 8000 {
                clipped = str.slice(text, 0, 8000)
            }
            util.abuf_append(ar, @addr(b), util.json_escape_buf(ar, clipped))
            util.abuf_append(ar, @addr(b), "\"}")
        }
        i++
    }
    util.abuf_append(ar, @addr(b), "\n]\n")
    return util.abuf_view(@addr(b))
}

pub fn render_404(
    ar: allocators.ScopedArenaAllocator,
    cfg: config.Config
) str.StringView = trust {
    val b: mut util.ABuf = util.abuf_new(ar)
    util.abuf_append(ar, @addr(b), HEAD_OPEN)
    util.abuf_append(ar, @addr(b), "Not found · ")
    attr(ar, @addr(b), cfg.title)
    util.abuf_append(ar, @addr(b), HEAD_TITLE_END)
    attr(ar, @addr(b), cfg.description)
    util.abuf_append(ar, @addr(b), HEAD_DESC_END)
    util.abuf_append(ar, @addr(b), "</head>\n")
    util.abuf_append(ar, @addr(b),
        \\<body>
        \\<header class="topbar">
        \\  <a class="brand" href="/">
        \\    <span class="brand-mark" aria-hidden="true">S</span>
        \\    <span class="brand-title">
    )
    attr(ar, @addr(b), cfg.title)
    util.abuf_append(ar, @addr(b),
        \\</span>
        \\  </a>
        \\</header>
        \\<main class="main" id="main-content">
        \\  <div class="content not-found">
        \\    <p class="breadcrumbs">404</p>
        \\    <h1 class="page-title">Page not found</h1>
        \\    <p class="page-description">The page you requested does not exist in this documentation set.</p>
        \\    <p><a href="/">Return to the home page</a></p>
        \\  </div>
        \\</main>
        \\</body>
        \\</html>
    )
    return util.abuf_view(@addr(b))
}
