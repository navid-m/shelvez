/// HTML page layout, navigation tree, and search index generation.

val allocators = use("std/allocators")
val config     = use("config.sx")
val markdown   = use("markdown.sx")
val str        = use("std/string")
val tree       = use("tree.sx")
val util       = use("sxutil.sx")

val embedded_css: ref u8 = @embed("web/style.css")
val embedded_js: ref u8 = @embed("web/shelvez.js")
val embedded_icon: ref u8 = @embed("web/favicon.svg")
val embedded_theme: ref u8 = @embed("web/theme.js")
val embedded_css_len: usize = @embedlen("web/style.css")
val embedded_js_len: usize = @embedlen("web/shelvez.js")
val embedded_icon_len: usize = @embedlen("web/favicon.svg")
val embedded_theme_len: usize = @embedlen("web/theme.js")

pub fn asset_css() str.StringView = {
    return str.view(embedded_css, embedded_css_len as i64)
}

pub fn asset_js() str.StringView = {
    return str.view(embedded_js, embedded_js_len as i64)
}

pub fn asset_favicon() str.StringView = {
    return str.view(embedded_icon, embedded_icon_len as i64)
}

pub fn asset_theme() str.StringView = {
    return str.view(embedded_theme, embedded_theme_len as i64)
}

/// Return the URL of the home page, falling back to the first page.
pub fn home_url(pages: list[ref tree.Page]) str.StringView = trust {
    val n: i64 = @len(pages) as i64
    if n > 0 {
        if @get(pages, 0 as usize) is some first {
            return first.url
        }
    }
    return "/"
}

